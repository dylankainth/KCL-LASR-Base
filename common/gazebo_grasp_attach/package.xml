<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_grasp_attach</name>
  <version>0.0.1</version>
  <description>Gazebo Classic world plugin that attaches/detaches an object to a robot link (grasp assist) via a ROS topic</description>
  <maintainer email="kainth.dylan@gmail.com">Dylan K</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
