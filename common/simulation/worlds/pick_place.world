<?xml version="1.0" ?>
<!--
  Minimal tabletop pick-and-place scene for TIAGo (robot spawns at the origin, facing +x).

  - table:      PAL table_0m8, top surface at z = 0.815
  - pick_object: 5 cm x 10 cm cylinder (can-sized), high friction, starts on the table (reset by the task scripts)
  - place_pad:  flat visual target on the table (no collision)
  - observer:   fixed camera publishing /observer/image_raw, used to record videos
-->
<sdf version="1.6">
  <world name="pick_place">
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Grasp assist: topic-driven fixed joint between gripper and object (see gazebo_grasp_attach) -->
    <plugin name="grasp_attach" filename="libgazebo_grasp_attach.so">
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>

    <!-- Ground-truth model states + get/set_entity_state services under /gazebo -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>50</update_rate>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://table_0m8</uri>
      <name>table</name>
      <pose>1.10 0 0 0 0 0</pose>
    </include>

    <!-- Can-sized cylinder (5 cm diameter, 10 cm tall): self-centres in a parallel-jaw grasp -->
    <model name="pick_object">
      <pose>0.75 0.05 0.865 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>1.7e-4</ixx><iyy>1.7e-4</iyy><izz>4.7e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>2.0</mu><mu2>2.0</mu2></ode>
            </friction>
            <contact>
              <ode><kp>5e5</kp><kd>100</kd><min_depth>0.0005</min_depth><max_vel>0.05</max_vel></ode>
            </contact>
          </surface>
        </collision>
        <sensor name="contact" type="contact">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <contact><collision>collision</collision></contact>
          <plugin name="object_bumper" filename="libgazebo_ros_bumper.so">
            <ros>
              <namespace>/pick_object</namespace>
              <remapping>bumper_states:=contacts</remapping>
            </ros>
            <frame_name>link</frame_name>
          </plugin>
        </sensor>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.10</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="place_pad">
      <pose>0.75 -0.20 0.8155 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <visual name="visual">
          <geometry><box><size>0.14 0.14 0.002</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="observer">
      <static>true</static>
      <pose>0.40 -1.40 1.50 0 0.5 1.20</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10</far></clip>
          </camera>
          <plugin name="observer_camera" filename="libgazebo_ros_camera.so">
            <camera_name>observer</camera_name>
            <frame_name>observer_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Close-up side view of the grasp area (x-z plane), for debugging and videos -->
    <model name="closeup">
      <static>true</static>
      <pose>0.75 -0.60 0.93 0 0 1.5708</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>0.55</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>5</far></clip>
          </camera>
          <plugin name="closeup_camera" filename="libgazebo_ros_camera.so">
            <camera_name>closeup</camera_name>
            <frame_name>closeup_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Close-up front view of the grasp area (y-z plane, looking at the robot) -->
    <model name="closeup_front">
      <static>true</static>
      <pose>1.45 0.0 0.93 0 0 3.14159</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>0.55</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>5</far></clip>
          </camera>
          <plugin name="closeup_front_camera" filename="libgazebo_ros_camera.so">
            <camera_name>closeup_front</camera_name>
            <frame_name>closeup_front_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
